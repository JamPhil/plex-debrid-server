# ===========================================
# Plex + Real-Debrid Server Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# IMPORTANT: Never commit .env to git — it contains secrets.

# --- Required: Get from https://real-debrid.com/apitoken ---
REAL_DEBRID_API_TOKEN=your_rd_api_token_here

# --- Required: Get from https://plex.tv/claim (valid 4 minutes!) ---
# Only needed on first deploy. Can be removed after Plex is claimed.
PLEX_CLAIM=

# --- Required: Plex token for API access ---
# Get from Plex web UI: open any media → ... → Get Info → View XML → copy X-Plex-Token from URL
PLEX_TOKEN=your_plex_token_here

# --- Required: Plex Watchlist RSS feed URL ---
# Get from https://www.plex.tv/accounts/watchlist-rss/
WATCHLIST_RSS=your_watchlist_rss_url_here

# --- Required: Discord webhook URL for alerts ---
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# --- Required: Residential proxy for Torrentio access ---
# Format: http://username:password@host:port
TORRENTIO_PROXY=http://user:pass@host:port

# --- Timezone ---
TIMEZONE=America/Chicago
