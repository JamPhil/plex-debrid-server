# ===========================================
# Plex + Real-Debrid Server Configuration
# ===========================================
# Copy this to .env and fill in your values.

# --- Timezone ---
TIMEZONE=America/Chicago

# --- Real-Debrid ---
# Get from: https://real-debrid.com/apitoken
REAL_DEBRID_API_TOKEN=

# --- Plex ---
# Claim: Get fresh from https://plex.tv/claim (expires in 4 minutes!)
# Token: After first login, get from any media item > Get Info > View XML > X-Plex-Token in URL
PLEX_CLAIM=
PLEX_TOKEN=

# --- Sonarr / Radarr ---
# Get API keys from each app's Settings > General page after first launch
SONARR_API_KEY=
RADARR_API_KEY=

# --- Overseerr ---
# Get API key from Overseerr Settings > General after first launch
OVERSEERR_API_KEY=

# --- Doplarr (Discord Bot) ---
# Create a Discord bot at https://discord.com/developers/applications
# Bot needs: Send Messages, Use Slash Commands, Read Message History permissions
DOPLARR_DISCORD_TOKEN=

# --- Discord Alerts (Grafana, Tautulli, Overseerr) ---
# Create webhook in Discord server > Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
