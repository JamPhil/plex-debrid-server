# ===========================================
# DUMB v2.3.0 — Plex + Real-Debrid Server
# ===========================================
# Most configuration is done through the DUMB dashboard (port 3005).
# This file documents the key credentials needed for initial setup
# and external integrations.

# --- Timezone ---
TIMEZONE=America/Chicago

# --- Real-Debrid ---
# Get from: https://real-debrid.com/apitoken
# Configured in DUMB onboarding wizard
REAL_DEBRID_API_TOKEN=

# --- Plex ---
# Claim: Get fresh from https://plex.tv/claim (expires in 4 minutes!)
# Token: After first login, get from any media item > Get Info > View XML > X-Plex-Token in URL
# Both configured during DUMB onboarding
PLEX_CLAIM=
PLEX_TOKEN=

# --- Discord Alerts (Tautulli) ---
# Create webhook in Discord server > Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# --- DUMB Dashboard ---
# Set during DUMB onboarding
DUMB_USERNAME=
DUMB_PASSWORD=

# --- Notes ---
# Service API keys (Sonarr, Radarr, Prowlarr, Seerr) are auto-generated
# by DUMB during onboarding. Find them in each service's Settings > General.
# The running docker-compose.yml is on the server at /opt/dumb/docker-compose.yml.
